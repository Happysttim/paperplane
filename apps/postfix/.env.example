# Service hostname (production: the MX target with matching A/PTR records).
POSTFIX_HOSTNAME=mail.paperplane.example
# apps/database의 POSTFIX_DB_PASSWORD와 동일하게 설정합니다.
# 공백/개행이 없는 비밀번호를 사용하며 $는 작은따옴표 안에 그대로 입력합니다.
POSTFIX_DB_HOST=postgres
POSTFIX_DB_PORT=5432
POSTFIX_DB_NAME=paperplane
POSTFIX_DB_USER=paperplane_postfix
POSTFIX_DB_PASSWORD='replace-with-postfix-password'

# Development: receive test mail on localhost:2525. Public MX: 0.0.0.0 + 25.
SMTP_BIND_ADDRESS=127.0.0.1
SMTP_PUBLIC_PORT=2525
# Keep reinjection on localhost; apps/smtp listens separately on host:10025.
SMTP_REINJECT_PORT=10026

# apps/smtp running on the Docker host. For a container on paperplane-mail use smtp.
FILTER_SMTP_HOST=host.docker.internal
FILTER_SMTP_PORT=10025

# Only trusted SMTP application containers should join this network.
# If the subnet changes, update the trusted CIDR too.
MAIL_NETWORK_SUBNET=172.30.25.0/24
POSTFIX_TRUSTED_NETWORKS=127.0.0.0/8,172.30.25.0/24
POSTFIX_MESSAGE_SIZE_LIMIT=26214400
