# %s는 Postfix가 SQL 인용 처리한 조회 도메인입니다.
# 존재하면 1을 반환하고, 없으면 행을 반환하지 않습니다.
query = SELECT 1 FROM public.domains WHERE name = '%s'
# apps/database Compose의 서비스 이름은 postgres입니다.
# 같은 Docker 네트워크에서 호스트 공개 포트가 아닌 내부 5432로 접속합니다.
hosts = postgres:5432
dbname = paperplane
user = paperplane_postfix
# password는 시작 시 POSTFIX_DB_PASSWORD에서 추가합니다.

