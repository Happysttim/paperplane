FROM debian:bookworm-slim
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends opendkim opendkim-tools openssl netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*
COPY config/opendkim.conf /etc/opendkim.conf
COPY opendkim-entrypoint.sh /usr/local/bin/paperplane-opendkim
RUN sed -i 's/\r$//' /usr/local/bin/paperplane-opendkim \
    && chmod 0755 /usr/local/bin/paperplane-opendkim
EXPOSE 8891
ENTRYPOINT ["/usr/local/bin/paperplane-opendkim"]
