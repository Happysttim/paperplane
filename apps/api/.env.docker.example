# HTTP 로컬 개발용입니다. HTTPS 운영 배포에서는 production으로 변경하세요.
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
# database 프로젝트 API_DB_PASSWORD를 URL 인코딩하여 넣습니다.
DB_URL=postgresql://paperplane_api:replace-with-api-password@postgres:5432/paperplane
# Redis와 인증 메일용 SMTP는 별도로 실행해야 합니다.
# 컨테이너의 localhost는 호스트가 아닙니다.
REDIS_ADDR=host.docker.internal
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0
MAILER_FROM=noreply@paperplane.life
MAILER_HOST=host.docker.internal
MAILER_PORT=10027
MAILER_SECURE=false
MAILER_AUTH_USER=
MAILER_AUTH_PASSWORD=
# OAuth를 사용할 때 실제 클라이언트와 웹 콜백 URL로 설정합니다.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/google/callback
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
OAUTH_NAVER_REDIRECT_URI=http://localhost:5173/oauth/naver/callback
