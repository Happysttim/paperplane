{
  "name": "paperplane",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --filter @apps/api dev",
    "build": "pnpm --filter @apps/api build",
    "typecheck": "pnpm --filter @apps/api typecheck",
    "lint": "pnpm --filter @apps/api lint",
    "test": "pnpm --filter @apps/api test",
    "dev:web": "pnpm --filter @apps/web dev",
    "build:web": "pnpm --filter @apps/web build",
    "check:web": "pnpm --filter @apps/web typecheck && pnpm --filter @apps/web lint && pnpm --filter @apps/web test"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "keywords": [],
  "engines": {
    "node": "22.19.0",
    "pnpm": "9.4.0"
  },
  "author": "happysttim",
  "packageManager": "pnpm@9.4.0",
  "devDependencies": {
    "@types/node": "^25.3.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "license": "ISC"
}
