# 루트 Compose 전용입니다. 프로젝트별 .env를 읽지 않습니다.
# URL에 삽입되는 API/MIGRATOR 비밀번호는 영문·숫자·_·-만 사용하세요(예: 임의 hex 64자).
POSTGRES_PASSWORD=replace-admin-password
API_DB_PASSWORD=replace-api-password
MIGRATOR_DB_PASSWORD=replace-migrator-password
POSTFIX_DB_PASSWORD=replace-postfix-password
NODE_ENV=development
WEB_PORT=8088
WEB_ORIGIN=http://localhost:8088
POSTFIX_HOSTNAME=mail.paperplane.example
MAILER_FROM=noreply@paperplane.life
SMTP_BIND_ADDRESS=127.0.0.1
SMTP_PUBLIC_PORT=2525
MAIL_NETWORK_SUBNET=172.30.26.0/24
JWT_PRIVATE_KEY_FILE=./apps/api/private.key
JWT_PUBLIC_KEY_FILE=./apps/api/public.key
HMAC_KEY_FILE=./apps/api/hmac.key
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8088/oauth/google/callback
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
OAUTH_NAVER_REDIRECT_URI=http://localhost:8088/oauth/naver/callback
